{
  "compilerOptions": {
    "target": "ES2021",
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "outDir": "server",
    "resolveJsonModule": true,
    "paths": {
      "typeorm": ["../../UnicoreCMS/node_modules/typeorm"]
    }
  },
  "include": ["server-src", "shared"]
}
