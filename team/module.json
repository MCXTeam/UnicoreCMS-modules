{
  "id": "team",
  "name": {
    "ru": "Команда проекта",
    "en": "Project team"
  },
  "description": {
    "ru": "Страница с составом команды: группы, участники, роли и описания",
    "en": "A page with the project team: groups, members, roles and notes"
  },
  "version": "1.2.1",
  "unicoreApi": "^1.4.0",
  "author": "UnicoreCMS",
  "license": "MIT",
  "server": "./server/index.js",
  "locales": "./locales",
  "componentPrefix": "ModTeam",
  "permissions": [
    "mod.team.read",
    "mod.team.write"
  ],
  "config": [
    {
      "key": "title",
      "type": "string",
      "default": "Команда проекта",
      "public": true,
      "label": "mod.team.config_title",
      "hint": "mod.team.config_title_hint"
    },
    {
      "key": "subtitle",
      "type": "string",
      "default": "Люди, которые делают проект",
      "public": true,
      "label": "mod.team.config_subtitle",
      "hint": "mod.team.config_subtitle_hint"
    },
    {
      "key": "global",
      "type": "string",
      "default": "На всех серверах",
      "public": true,
      "label": "mod.team.config_global",
      "hint": "mod.team.config_global_hint"
    },
    {
      "key": "rest",
      "type": "string",
      "default": "Без категории",
      "public": true,
      "label": "mod.team.config_rest",
      "hint": "mod.team.config_rest_hint"
    },
    {
      "key": "display",
      "type": "select",
      "default": "categories",
      "public": true,
      "label": "mod.team.config_display",
      "hint": "mod.team.config_display_hint",
      "options": [
        {
          "label": "По серверам",
          "value": "servers"
        },
        {
          "label": "По категориям",
          "value": "categories"
        },
        {
          "label": "Всё вместе",
          "value": "all"
        }
      ]
    }
  ],
  "client": "./client",
  "admin": "./admin"
}
